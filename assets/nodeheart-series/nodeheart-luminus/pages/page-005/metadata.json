  "learning": {
    "sentences": [
      {
        "japanese": "ズゥオオオオ。",
        "reading": "ズゥオオオオ。",
        "romaji": "Zuoooo.",
        "english": "A massive roar rumbles out.",
        "note": "This stretched sound effect makes the monster feel huge and heavy."
      },
      {
        "japanese": "なんだ...あの化け物は...！？",
        "reading": "なんだ...あの ばけものは...！？",
        "romaji": "Nanda... ano bakemono wa...!?",
        "english": "What is that monster!?",
        "note": "なんだ expresses shock: 'what is it?' or 'what the...'"
      },
      {
        "japanese": "あの子が...あの怪物と戦うのか...！？",
        "reading": "あのこが...あの かいぶつと たたかうのか...！？",
        "romaji": "Ano ko ga... ano kaibutsu to tatakau no ka...!?",
        "english": "That child is going to fight that monster!?",
        "note": "のか turns the statement into an emotional question."
      },
      {
        "japanese": "嘘だろ...生きて帰れるわけがない！！",
        "reading": "うそだろ...いきて かえれる わけがない！！",
        "romaji": "Uso daro... ikite kaereru wake ga nai!!",
        "english": "No way... there is no chance he can make it back alive!",
        "note": "わけがない means 'there is no reason/chance that...'"
      },
      {
        "japanese": "あれは伝説の深淵の魔獣...！！",
        "reading": "あれは でんせつの しんえんの まじゅう...！！",
        "romaji": "Are wa densetsu no shin'en no maju...!!",
        "english": "That is the legendary beast of the abyss!",
        "note": "深淵 is a dramatic word for an abyss or deep chasm."
      },
      {
        "japanese": "どう考えても勝てるはずがない...！！",
        "reading": "どう かんがえても かてる はずがない...！！",
        "romaji": "Do kangaete mo kateru hazu ga nai...!!",
        "english": "No matter how you look at it, he cannot possibly win!",
        "note": "どう考えても means 'however you think about it.' はずがない rejects the possibility."
      },
      {
        "japanese": "なんてことをしやがるんだシャークキング...！！",
        "reading": "なんてことを しやがるんだ シャークキング...！！",
        "romaji": "Nante koto o shiyagaru n da Shaku Kingu...!!",
        "english": "What has Shark King done!?",
        "note": "しやがる is a hostile, contempt-filled way to describe someone's action."
      }
    ],
