  "learning": {
    "sentences": [
      {
        "japanese": "キング・ハンマーは少年を見下ろし、大きな笑い声をあげた。",
        "reading": "キング・ハンマーは しょうねんを みおろし、おおきな わらいごえを あげた。",
        "romaji": "Kingu Hanma wa shonen o mioroshi, ookina waraigoe o ageta.",
        "english": "King Hammer looked down at the boy and let out a booming laugh.",
        "note": "見下ろす means to look down from above, physically or socially."
      },
      {
        "japanese": "姉を取り戻したければ、生き残れ！",
        "reading": "あねを とりもどしたければ、いきのこれ！",
        "romaji": "Ane o torimodoshitakereba, ikinokore!",
        "english": "If you want your sister back, survive!",
        "note": "たければ means 'if you want to.' 生き残れ is the command form of 生き残る."
      },
      {
        "japanese": "戦うしかない。姉を救うために、もっと強くなる。",
        "reading": "たたかうしかない。あねを すくうために、もっと つよくなる。",
        "romaji": "Tatakau shika nai. Ane o sukuu tame ni, motto tsuyoku naru.",
        "english": "I have no choice. To save my sister, I must become stronger.",
        "note": "しかない means 'there is nothing but...' or 'there is no choice but to...'"
      },
      {
        "japanese": "さあ、闘技場へ入れ！",
        "reading": "さあ、とうぎじょうへ はいれ！",
        "romaji": "Sa, togijo e haire!",
        "english": "Now, enter the arena!",
        "note": "入れ is a direct command form of 入る, 'enter.'"
      },
      {
        "japanese": "姉を返せ！オレは、あきらめない！",
        "reading": "あねを かえせ！オレは、あきらめない！",
        "romaji": "Ane o kaese! Ore wa, akiramenai!",
        "english": "Give my sister back! I will never give up!",
        "note": "あきらめない is the negative form of あきらめる, 'to give up.'"
      }
    ],
    "vocabulary": [
      {
        "term": "少年",
        "reading": "しょうねん",
        "romaji": "shonen",
        "meaning": "boy",
        "note": "Common narration word for a young boy."
      },
      {
        "term": "見下ろす",
        "reading": "みおろす",
        "romaji": "miorosu",
        "meaning": "to look down at",
        "note": "Can imply superiority when used in a confrontation."
      },
      {
        "term": "笑い声",
        "reading": "わらいごえ",
        "romaji": "waraigoe",
        "meaning": "laughing voice; laughter",
        "note": "声 attaches to show the sound of something."
      },
      {
        "term": "取り戻す",
        "reading": "とりもどす",
        "romaji": "torimodosu",
        "meaning": "to take back; recover",
        "note": "Used for reclaiming something lost or stolen."
      },
      {
        "term": "生き残る",
        "reading": "いきのこる",
        "romaji": "ikinokoru",
        "meaning": "to survive",
        "note": "Literally 'remain alive.'"
      },
      {
        "term": "救う",
        "reading": "すくう",
        "romaji": "sukuu",
        "meaning": "to save; rescue",
        "note": "Often used for rescuing people."
      },
      {
        "term": "闘技場",
        "reading": "とうぎじょう",
        "romaji": "togijo",
        "meaning": "arena",
        "note": "A fighting arena or coliseum."
      },
      {
        "term": "あきらめない",
        "reading": "あきらめない",
        "romaji": "akiramenai",
        "meaning": "will not give up",
        "note": "A useful resolve phrase in stories."
      }
    ]
  },
