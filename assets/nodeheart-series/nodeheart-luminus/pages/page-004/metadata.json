      {
        "japanese": "闘技場に、歓声が響き渡った。",
        "reading": "とうぎじょうに、かんせいが ひびきわたった。",
        "romaji": "Togijo ni, kansei ga hibikiwatatta.",
        "english": "The cheers echoed throughout the arena.",
        "note": "響き渡る means a sound spreads or resounds across a place."
      },
      {
        "japanese": "海の戦士たちよ！本日の特別試合を発表する！",
        "reading": "うみの せんしたちよ！ほんじつの とくべつしあいを はっぴょうする！",
        "romaji": "Umi no senshi-tachi yo! Honjitsu no tokubetsu shiai o happyo suru!",
        "english": "Warriors of the sea! I will announce today's special match!",
        "note": "たち makes 戦士 plural. 本日 is a formal way to say 'today.'"
      },
      {
        "japanese": "生き残った者だけが、姉を救う権利を得る！健闘を祈る！",
        "reading": "いきのこった ものだけが、あねを すくう けんりを える！けんとうを いのる！",
        "romaji": "Ikinokotta mono dake ga, ane o sukuu kenri o eru! Kento o inoru!",
        "english": "Only the one who survives will earn the right to save his sister! May your strength be with you!",
        "note": "者 is a formal word for person. 権利を得る means 'gain the right.'"
      },
      {
        "japanese": "オオオオオ！！",
        "reading": "オオオオオ！！",
        "romaji": "Ooooo!!",
        "english": "The crowd roars!",
        "note": "Long vowel sound effects stretch the sound dramatically."
      },
      {
        "japanese": "戦えーっ！！始めろーっ！！",
        "reading": "たたかえーっ！！はじめろーっ！！",
        "romaji": "Tatakae!! Hajimero!!",
        "english": "Fight! Start!",
        "note": "Both are command forms shouted by the crowd."
      },
      {
        "japanese": "ギロ...",
        "reading": "ギロ...",
        "romaji": "Giro...",
        "english": "A sharp glare...",
        "note": "ギロ is a sound effect for staring or glaring intensely."
      }
