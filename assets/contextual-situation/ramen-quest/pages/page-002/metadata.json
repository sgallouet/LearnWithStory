      {
        "japanese": "いらっしゃい！",
        "reading": "いらっしゃい！",
        "english": "Welcome!",
        "note": "A standard greeting when entering a shop or restaurant.",
        "romaji": "Irasshai!"
      },
      {
        "japanese": "ひとり？ / はい、ひとりです。",
        "reading": "ひとり？ / はい、ひとりです。",
        "english": "One person? / Yes, one person.",
        "note": "ひとり means one person. The polite answer adds です.",
        "romaji": "Hitori? / Hai, hitori desu."
      },
      {
        "japanese": "どこから来たの？ / アメリカから来ました。",
        "reading": "どこから きたの？ / アメリカから きました。",
        "english": "Where are you from? / I came from America.",
        "note": "から marks the origin or starting point.",
        "romaji": "Doko kara kita no? / Amerika kara kimashita."
      },
      {
        "japanese": "ラーメンは何が好き？",
        "reading": "ラーメンは なにが すき？",
        "english": "What kind of ramen do you like?",
        "note": "何が好き asks what someone likes from a set of choices.",
        "romaji": "Ramen wa nani ga suki?"
      },
      {
        "japanese": "とんこつラーメンをお願いします！",
        "reading": "とんこつラーメンを おねがいします！",
        "english": "Tonkotsu ramen, please!",
        "note": "をお願いします is a polite ordering pattern.",
        "romaji": "Tonkotsu ramen o onegai shimasu!"
      },
      {
        "japanese": "麺のかたさは？ / バリカタでお願いします！",
        "reading": "めんの かたさは？ / バリカタで おねがいします！",
        "english": "How firm would you like the noodles? / Very firm, please!",
        "note": "で can mark the chosen option when ordering.",
        "romaji": "Men no katasa wa? / Barikata de onegai shimasu!"
      }
    ],
