      {
        "japanese": "はい、どうぞ。 / ありがとう！",
        "reading": "はい、どうぞ。 / ありがとう！",
        "english": "Here you are. / Thank you!",
        "note": "どうぞ is used when offering or handing something to someone.",
        "romaji": "Hai, dozo. / Arigato!"
      },
      {
        "japanese": "また来てね！おすすめは味噌ラーメンだよ！",
        "reading": "また きてね！おすすめは みそラーメンだよ！",
        "english": "Come again! I recommend our miso ramen!",
        "note": "また来てね is a friendly invitation to come back.",
        "romaji": "Mata kite ne! Osusume wa miso ramen da yo!"
      },
      {
        "japanese": "次は別の味も試してみよう！",
        "reading": "つぎは べつの あじも ためしてみよう！",
        "english": "Next time, I'll try a different flavor too!",
        "note": "試してみよう means 'let's try' or 'I'll try'.",
        "romaji": "Tsugi wa betsu no aji mo tameshite miyou!"
      }
