  "learning": {
    "sentences": [
      {
        "japanese": "車内は思ったより静かだなあ。",
        "reading": "しゃないは おもったより しずかだなあ。",
        "romaji": "Shanai wa omotta yori shizuka da na.",
        "english": "The train is quieter than I expected.",
        "note": "より means “than” in comparisons."
      },
      {
        "japanese": "車内ではマナーモードに設定し、通話はご遠慮ください。",
        "reading": "しゃないでは マナーモードに せっていし、つうわは ごえんりょください。",
        "romaji": "Shanai de wa mana modo ni settei shi, tsuwa wa goenryo kudasai.",
        "english": "Please set your phone to silent mode and refrain from phone calls.",
        "note": "ご遠慮ください is a polite “please refrain.”"
      },
      {
        "japanese": "次は、新宿、新宿です。お出口は右側です。",
        "reading": "つぎは、しんじゅく、しんじゅくです。おでぐちは みぎがわです。",
        "romaji": "Tsugi wa Shinjuku, Shinjuku desu. Odeguchi wa migigawa desu.",
        "english": "Next is Shinjuku. The doors will open on the right.",
        "note": "お出口 is polite station-announcement wording."
      },
      {
        "japanese": "電話はしない方がいいんだね。",
        "reading": "でんわは しない ほうが いいんだね。",
        "romaji": "Denwa wa shinai ho ga ii n da ne.",
        "english": "So it is better not to make phone calls.",
        "note": "ない方がいい means “it is better not to.”"
      },
      {
        "japanese": "車内では静かにして、優先席やマナーの案内も確認します。",
        "reading": "しゃないでは しずかにして、ゆうせんせきや マナーの あんないも かくにんします。",
        "romaji": "Shanai de wa shizuka ni shite, yusenseki ya mana no annai mo kakunin shimasu.",
        "english": "Keep quiet in the train and pay attention to priority seat and etiquette notices.",
        "note": "や lists examples, not an exhaustive list."
      }
    ],
