  "learning": {
    "sentences": [
      {
        "japanese": "みんな、ちゃんと並んでる。",
        "reading": "みんな、ちゃんと ならんでる。",
        "romaji": "Minna, chanto naranderu.",
        "english": "Everyone is lining up properly.",
        "note": "並んでる is casual contraction of 並んでいる."
      },
      {
        "japanese": "私もここで待とう。",
        "reading": "わたしも ここで まとう。",
        "romaji": "Watashi mo koko de mato.",
        "english": "I will wait here too.",
        "note": "待とう is volitional for “let me/us wait.”"
      },
      {
        "japanese": "危ないですから、黄色い線の内側までお下がりください。",
        "reading": "あぶないですから、きいろい せんの うちがわまで おさがりください。",
        "romaji": "Abunai desu kara, kiiroi sen no uchigawa made osagari kudasai.",
        "english": "For your safety, please stand behind the yellow line.",
        "note": "ですから gives the reason before the request."
      },
      {
        "japanese": "ホームでは、ドアの前ではなく、乗車位置に並びます。",
        "reading": "ホームでは、ドアの まえではなく、じょうしゃいちに ならびます。",
        "romaji": "Homu de wa, doa no mae de wa naku, joshai-ichi ni narabimasu.",
        "english": "On the platform, line up at the boarding marks rather than blocking the doors.",
        "note": "ではなく means “not at/in, but...”"
      }
    ],
    "vocabulary": [
      {
        "term": "並ぶ",
        "reading": "ならぶ",
        "romaji": "narabu",
        "meaning": "to line up",
        "note": "Intransitive verb for queues."
      },
      {
        "term": "乗車位置",
        "reading": "じょうしゃいち",
        "romaji": "joshai-ichi",
        "meaning": "boarding position",
        "note": "Marked place to wait."
      },
      {
        "term": "整列乗車",
        "reading": "せいれつじょうしゃ",
        "romaji": "seiretsu josha",
        "meaning": "orderly boarding",
        "note": "Platform etiquette phrase."
      },
      {
        "term": "危ない",
        "reading": "あぶない",
        "romaji": "abunai",
        "meaning": "dangerous",
        "note": "Safety warning adjective."
      },
      {
        "term": "お下がりください",
        "reading": "おさがりください",
        "romaji": "osagari kudasai",
        "meaning": "please step back",
        "note": "Polite announcement phrase."
      },
      {
        "term": "ドア",
        "reading": "ドア",
        "romaji": "doa",
        "meaning": "door",
        "note": "Loanword."
      }
    ]
  },
