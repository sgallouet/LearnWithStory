  "learning": {
    "sentences": [
      {
        "japanese": "今日から東京で初出勤。",
        "reading": "きょうから とうきょうで はつしゅっきん。",
        "romaji": "Kyo kara Tokyo de hatsu-shukkin.",
        "english": "My first commute to work in Tokyo starts today.",
        "note": "から marks the starting point, and で marks Tokyo as the place."
      },
      {
        "japanese": "人が多いなあ。でも、行ってみよう。",
        "reading": "ひとが おおいなあ。でも、いってみよう。",
        "romaji": "Hito ga oi na. Demo, itte miyou.",
        "english": "There are so many people, but okay, let us try.",
        "note": "てみよう means “let us try doing it.”"
      },
      {
        "japanese": "駅まで来れば、なんとかなるよね。",
        "reading": "えきまで くれば、なんとか なるよね。",
        "romaji": "Eki made kureba, nantoka naru yo ne.",
        "english": "Once I get to the station, I will figure it out, right?",
        "note": "くれば is the conditional “if/when I come.”"
      },
      {
        "japanese": "朝の駅は人が多いので、立ち止まる時は端によります。",
        "reading": "あさの えきは ひとが おおいので、たちどまる ときは はしに よります。",
        "romaji": "Asa no eki wa hito ga oi node, tachidomaru toki wa hashi ni yorimasu.",
        "english": "Morning stations are crowded, so step to the side if you need to stop.",
        "note": "ので gives a reason; 時 marks “when.”"
      },
      {
        "japanese": "よし、行こう。",
        "reading": "よし、いこう。",
        "romaji": "Yoshi, iko.",
        "english": "Okay, let us go.",
        "note": "行こう is the volitional “let us go.”"
      }
    ],
    "vocabulary": [
      {
        "term": "通勤",
        "reading": "つうきん",
        "romaji": "tsukin",
        "meaning": "commute to work",
