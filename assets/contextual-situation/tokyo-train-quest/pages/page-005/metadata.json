        "japanese": "ドアが開きます。ご注意ください。",
        "reading": "ドアが ひらきます。ごちゅういください。",
        "romaji": "Doa ga hirakimasu. Gochui kudasai.",
        "english": "The doors will open. Please be careful.",
        "note": "ご + noun + ください makes a polite request."
      },
      {
        "japanese": "先に降りる人を待つんだ。",
        "reading": "さきに おりる ひとを まつんだ。",
        "romaji": "Saki ni oriru hito o matsu n da.",
        "english": "I should let people get off first.",
        "note": "降りる人 means “people who get off.”"
      },
      {
        "japanese": "すみません。",
        "reading": "すみません。",
        "romaji": "Sumimasen.",
        "english": "Excuse me.",
        "note": "Useful for moving through a crowd politely."
      },
      {
        "japanese": "ドアが閉まります。ご注意ください。",
        "reading": "ドアが しまります。ごちゅういください。",
        "romaji": "Doa ga shimarimasu. Gochui kudasai.",
        "english": "The doors are closing. Please be careful.",
        "note": "閉まります is intransitive: the door closes."
      },
      {
        "japanese": "電車では、先に降りる人を通してから乗ります。",
        "reading": "でんしゃでは、さきに おりる ひとを とおしてから のります。",
        "romaji": "Densha de wa, saki ni oriru hito o toshite kara norimasu.",
        "english": "On trains, let people get off before you board.",
        "note": "てから means “after doing.”"
      }
    ],
