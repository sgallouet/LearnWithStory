    "sentences": [
      {
        "japanese": "まもなく、赤坂見附、赤坂見附です。",
        "reading": "まもなく、あかさかみつけ、あかさかみつけです。",
        "romaji": "Mamonaku, Akasaka-mitsuke, Akasaka-mitsuke desu.",
        "english": "We will soon arrive at Akasaka-mitsuke.",
        "note": "まもなく means soon, often in announcements."
      },
      {
        "japanese": "会社は出口3から徒歩5分。",
        "reading": "かいしゃは でぐち さんから とほ ごふん。",
        "romaji": "Kaisha wa deguchi san kara toho go-fun.",
        "english": "The office is five minutes on foot from Exit 3.",
        "note": "から marks the starting point."
      },
      {
        "japanese": "よし、間に合いそう。",
        "reading": "よし、まにあいそう。",
        "romaji": "Yoshi, maniaiso.",
        "english": "Okay, I will make it on time.",
        "note": "そう after a verb stem means “looks like.”"
      },
      {
        "japanese": "電車、大丈夫でしたか？",
        "reading": "でんしゃ、だいじょうぶでしたか。",
        "romaji": "Densha, daijobu deshita ka.",
        "english": "Was the train okay?",
        "note": "A natural check-in question at work."
      },
      {
        "japanese": "少し迷いましたが、着きました。",
        "reading": "すこし まよいましたが、つきました。",
        "romaji": "Sukoshi mayoimashita ga, tsukimashita.",
        "english": "I got a little lost, but I made it.",
        "note": "が contrasts the two clauses politely."
      },
      {
        "japanese": "初めての通勤、できた。",
        "reading": "はじめての つうきん、できた。",
        "romaji": "Hajimete no tsukin, dekita.",
        "english": "I did my first commute.",
        "note": "できた means “was able to do it.”"
      }
    ],
    "vocabulary": [
