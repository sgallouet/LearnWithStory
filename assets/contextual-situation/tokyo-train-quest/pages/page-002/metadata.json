  "learning": {
    "sentences": [
      {
        "japanese": "えっと、ICカードはここで使うんだよね。",
        "reading": "えっと、アイシーカードは ここで つかうんだよね。",
        "romaji": "Etto, ai-shi-kado wa koko de tsukau n da yo ne.",
        "english": "Um, I use my IC card here, right?",
        "note": "んだよね sounds like checking or confirming."
      },
      {
        "japanese": "ICカードをタッチします。",
        "reading": "アイシーカードを タッチします。",
        "romaji": "Ai-shi-kado o tacchi shimasu.",
        "english": "Tap your IC card.",
        "note": "を marks the thing being tapped."
      },
      {
        "japanese": "よかった、通れた。",
        "reading": "よかった、とおれた。",
        "romaji": "Yokatta, toreta.",
        "english": "Good, I got through.",
        "note": "通れた is potential past: “was able to pass.”"
      },
      {
        "japanese": "改札では立ち止まらず、カードやスマホを先に準備します。",
        "reading": "かいさつでは たちどまらず、カードや スマホを さきに じゅんびします。",
        "romaji": "Kaisatsu de wa tachidomarazu, kado ya sumaho o saki ni junbi shimasu.",
        "english": "At the gate, prepare your card or phone before you get there.",
        "note": "ず after a verb means “without doing.”"
      },
      {
        "japanese": "次はホームを探そう。",
        "reading": "つぎは ホームを さがそう。",
        "romaji": "Tsugi wa homu o sagaso.",
        "english": "Next, I need to find the platform.",
        "note": "探そう is volitional: “let us look for.”"
      }
    ],
    "vocabulary": [
      {
        "term": "ICカード",
        "reading": "アイシーカード",
