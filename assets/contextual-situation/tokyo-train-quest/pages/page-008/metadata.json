    "sentences": [
      {
        "japanese": "快速、私の駅に止まるのかな？",
        "reading": "かいそく、わたしの えきに とまるのかな。",
        "romaji": "Kaisoku, watashi no eki ni tomaru no kana?",
        "english": "Rapid, does it stop at my station?",
        "note": "のかな expresses wondering."
      },
      {
        "japanese": "すみません、この電車は赤坂見附に止まりますか。",
        "reading": "すみません、この でんしゃは あかさかみつけに とまりますか。",
        "romaji": "Sumimasen, kono densha wa Akasaka-mitsuke ni tomarimasu ka.",
        "english": "Excuse me, does this train stop at Akasaka-mitsuke?",
        "note": "に marks the stop/location."
      },
      {
        "japanese": "はい、止まります。でも次の各駅停車でも大丈夫ですよ。",
        "reading": "はい、とまります。でも つぎの かくえきていしゃでも だいじょうぶですよ。",
        "romaji": "Hai, tomarimasu. Demo tsugi no kakueki-teisha demo daijobu desu yo.",
        "english": "Yes, it stops there. But the next local train is also fine.",
        "note": "でも after a noun can mean “even/also.”"
      },
      {
        "japanese": "「この電車は○○に止まりますか？」はとても便利な質問です。",
        "reading": "「この でんしゃは ○○に とまりますか？」は とても べんりな しつもんです。",
        "romaji": "“Kono densha wa marumaru ni tomarimasu ka?” wa totemo benri na shitsumon desu.",
        "english": "Does this train stop at __? is a very useful question.",
        "note": "A reusable template for checking stops."
      }
    ],
