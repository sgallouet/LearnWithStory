  "learning": {
    "sentences": [
      {
        "japanese": "出口が多すぎる。",
        "reading": "でぐちが おおすぎる。",
        "romaji": "Deguchi ga osugiru.",
        "english": "There are too many exits.",
        "note": "すぎる after an adjective means “too much.”"
      },
      {
        "japanese": "乗り換えはどっち？",
        "reading": "のりかえは どっち？",
        "romaji": "Norikae wa dotchi?",
        "english": "Which way is the transfer?",
        "note": "どっち is casual “which way.”"
      },
      {
        "japanese": "すみません、丸ノ内線はどこですか。",
        "reading": "すみません、まるのうちせんは どこですか。",
        "romaji": "Sumimasen, Marunouchi-sen wa doko desu ka.",
        "english": "Excuse me, where is the Marunouchi Line?",
        "note": "A direct and polite station question."
      },
      {
        "japanese": "この階段を上がって、赤い案内に沿って進んでください。",
        "reading": "この かいだんを あがって、あかい あんないに そって すすんでください。",
        "romaji": "Kono kaidan o agatte, akai annai ni sotte susunde kudasai.",
        "english": "Go up these stairs and follow the red signs.",
        "note": "て-form links sequential instructions."
      },
      {
        "japanese": "迷ったら「すみません、○○線はどこですか？」と聞くと便利です。",
        "reading": "まよったら「すみません、○○せんは どこですか？」と きくと べんりです。",
        "romaji": "Mayottara “Sumimasen, marumaru-sen wa doko desu ka?” to kiku to benri desu.",
        "english": "If you are lost, it is useful to ask: Excuse me, where is the __ Line?",
        "note": "たら gives a condition: “if/when.”"
      }
    ],
